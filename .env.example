# ═══ Feuerwehr-Einsatz-Monitor — docker compose Umgebungsvariablen ═══
# Diese Datei als ".env" neben die docker-compose.yml legen (Werte anpassen!).

# Pflicht — Bot-Token vom @BotFather:
FW_BOT_TOKEN=123456789:DEIN-TOKEN-HIER

# Pflicht — deine Telegram-Chat-ID (der Admin):
FW_ADMIN_ID=123456789

# Optional — Name deiner Feuerwehr (Default: Offenhausen):
FW_FF_NAME=Musterwehr

# Optional — einsaetze.at-Org-ID (leer = Auto-Findung über den Feuerwehr-Index):
FW_ORG_ID=

# Optional — Sekunden zwischen den Abfragen (Default: 60):
FW_POLL_INTERVAL=60

# Optional — maximale Anzahl Nützer (Default: 2000):
FW_MAX_USERS=2000

# Optional — Zeitzone (Default: Europe/Vienna):
TZ=Europe/Vienna
